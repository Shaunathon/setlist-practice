# Copy to .env and fill in. NEVER commit .env.
# Create the key at https://console.cloud.google.com/apis/credentials
# in the same Google Cloud project you used for the playlist generator,
# then enable "YouTube Data API v3" and restrict the key to that API.
#
# This value is read only by the Netlify Function (server side).
# It is never bundled into the browser build.
#
# This file is COMMITTED and the repo is public — never put a real key here.
# The real key belongs in .env, which is gitignored.
YOUTUBE_API_KEY=

# Optional, browser side: iframe a local makam-keyboard dev server in the
# bottom dock instead of https://shaunathon.github.io/makam-keyboard/?dock=1.
# Only useful while working on the keyboard itself.
# VITE_MAKAM_KEYBOARD_URL=http://localhost:5180/makam-keyboard/?dock=1
