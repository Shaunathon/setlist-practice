# Copy to .env and fill in. NEVER commit .env.
# Create the key at https://console.cloud.google.com/apis/credentials
# in the same Google Cloud project you used for the playlist generator,
# then enable "YouTube Data API v3" and restrict the key to that API.
#
# This value is read only by the Netlify Function (server side).
# It is never bundled into the browser build.
YOUTUBE_API_KEY=
